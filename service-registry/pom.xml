<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>
    
    <!-- 
        This module inherits from our parent POM.
        All common dependencies and configurations come from parent.
    -->
    <parent>
        <groupId>com.grievance</groupId>
        <artifactId>grievance-redressal-system-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    
    <!-- 
        Only artifactId is required here.
        groupId and version are inherited from parent.
    -->
    <artifactId>service-registry</artifactId>
    <n>Service Registry</n>
    <description>
        Eureka Server for Service Discovery.
        All microservices register here and discover each other.
        Dashboard available at http://localhost:8761
    </description>
    
    <!-- 
        Only service-specific dependencies are listed here.
        Common dependencies (Lombok, Test) come from parent.
    -->
    <dependencies>
        
        <!-- 
            Eureka Server - Netflix Service Discovery
            This makes this application a Eureka Server where other 
            microservices can register themselves.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>
        
        <!-- 
            Spring Boot Actuator - Health Checks & Monitoring
            Provides endpoints like /actuator/health for monitoring.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
    </dependencies>
    
    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin - Creates executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    
</project>